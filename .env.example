# Mathly — public Expo env (copy to .env; gitignored). EXPO_PUBLIC_* vars are
# inlined into the JS bundle at build time. In CI these come from GitHub secrets.

# Backend API — the Vercel-deployed /api serverless functions in this repo.
# Powers src/lib/api.ts (solve + chat). Leave pointing at your deployment.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# RevenueCat public SDK keys — one per store app (see src/lib/purchases.ts).
# EXPO_PUBLIC_REVENUECAT_KEY: Android/Play Store (goog_...).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY: iOS/App Store (appl_...).
# Empty → the app runs with simulated purchases (dev/e2e only).
EXPO_PUBLIC_REVENUECAT_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# E2E mode — set by Playwright. Shows the "Use test photo" button in the scanner
# and makes api.ts return canned solutions instead of calling the backend.
EXPO_PUBLIC_E2E=
EXPO_PUBLIC_E2E_STUB_API=

# RevenueCat test-mode SECRET API key (test_…). Server/e2e only — deliberately
# NOT EXPO_PUBLIC_: a secret key must never be inlined into a shipped bundle.
# The checkout e2e preflight calls the RevenueCat API with it to prove the
# current offering actually has the mathly_pro_yearly / mathly_pro_weekly
# packages attached; an empty offering is what leaves Subscribe dead in review.
# In CI this comes from the REVENUECAT_TEST_KEY GitHub secret.
REVENUECAT_TEST_KEY=

# RevenueCat REST API v2 management key (sk_…) — catalog administration only
# (products/offerings/packages), never shipped to clients. Used by
# `npm run revenuecat:catalog` to wire both plans into the current offering.
# In CI this comes from the REVENUECAT_MANAGEMENT_KEY GitHub secret.
REVENUECAT_MANAGEMENT_KEY=
