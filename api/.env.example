# API env for local dev (`vercel dev` or `node api/dev.mjs`).
# In production set these in Vercel → Project → Settings → Environment Variables.
# The OpenAI key lives ONLY here (server-side) — never in the app bundle.

# From your OpenAI dashboard. The one used during development came from the
# looxmaxxing-api project's .env (gpt-image-2 / gpt-5.4-nano enabled).
OPENAI_API_KEY=

# Any chat-completions model available to the key above.
# gpt-5.4-nano is cheap and fast; bump to gpt-5.4-mini for harder problems.
OPENAI_MODEL=gpt-5.4-nano
